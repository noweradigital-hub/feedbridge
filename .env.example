# Povinné
ADMIN_PASSWORD=zmen-ma
PUBLIC_URL=https://feeds.tvoja-domena.sk

# Voliteľné
ADMIN_USER=admin
PORT=3000
DATA_DIR=/data
IMAGE_CONCURRENCY=3
# provider "removebg"
REMOVEBG_API_KEY=
# provider "rembg"
REMBG_URL=
# upozornenie pri zmene stavu behu (chyba, poistka, zotavenie): webhook v n8n alebo Slacku
NOTIFY_WEBHOOK_URL=
# ako dlho držať obrázky, ktoré už vo feede nie sú (Meta ich môže mať ešte v starom feede)
IMAGE_RETENTION_DAYS=7
# po koľkých hodinách overiť, či sa zdrojová fotka pod rovnakou URL nezmenila
ORIG_CACHE_HOURS=24
# len pre lokálny vývoj: povolí sťahovanie z interných adries (127.0.0.1, 10.x…)
# ALLOW_PRIVATE_FETCH=1
